{
  "title": "Berth - API Overview",
  "uid": "berth-api",
  "tags": ["berth"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate (req/s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${job}"},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"berth-backend\"}[5m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p95 (5m)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${job}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"berth-backend\"}[5m])) by (le, handler))",
          "legendFormat": "p95 {{handler}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (4xx/5xx per second)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${job}"},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"berth-backend\", status=~\"[45]..\"}[5m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by status code",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${job}"},
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{app=\"berth-backend\"}[1h])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
