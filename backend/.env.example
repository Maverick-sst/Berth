# Berth - environment placeholders (copy to .env and adjust; never commit real values)

# Backend
DATABASE_URL=postgresql+psycopg://taskboard:taskboard@localhost:5432/taskboard

# Compose stack uses the service hostname "postgres" instead of localhost:
# DATABASE_URL=postgresql+psycopg://taskboard:taskboard@postgres:5432/taskboard

# Comma-separated list of allowed CORS origins (default "*" allows all - tighten for production)
# CORS_ORIGINS=http://localhost:3000

# Shared secret that authorizes CI to report deployment outcomes to POST /api/deployments/report
# Generate with: openssl rand -hex 32
# DEPLOY_REPORT_TOKEN=change-me
